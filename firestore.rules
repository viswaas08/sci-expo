rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isTeacher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isAdminOrTeacher() { return isAdmin() || isTeacher(); }

    // All collections use public reads (multi-portal Firebase app instances mean
    // student/parent auth tokens are not visible to the adminApp-bound Firestore)
    // Writes are restricted to authenticated admin/teacher roles.

    match /users/{userId} {
      allow read: if true;
      allow write: if isAdminOrTeacher() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null;
    }
    match /departments/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}          { allow read, write: if isAdmin(); }
    match /exams/{id}           { allow read: if true; allow write: if isAdminOrTeacher(); }
    match /marks/{id}           { allow read: if true; allow write: if isAdminOrTeacher(); }
    match /attendance/{id}      { allow read: if true; allow write: if isAdminOrTeacher(); }
    match /announcements/{id}   { allow read: if true; allow write: if isAdminOrTeacher(); }
    match /timetable/{id}       { allow read: if true; allow write: if isAdminOrTeacher(); }
    match /assignments/{id}     { allow read: if true; allow write: if request.auth != null; }
    match /leaveRequests/{id}   { allow read: if true; allow write: if request.auth != null; }
    match /chat/{id}            { allow read: if true; allow write: if request.auth != null; }
    match /auditLog/{id}        { allow read: if isAdmin(); allow write: if request.auth != null; }
  }
}
