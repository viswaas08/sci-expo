rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedInAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSignedInTeacher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    function isAdminOrTeacher() { return isSignedInAdmin() || isSignedInTeacher(); }

    // Users — public read (student/parent portals use separate Firebase apps;
    // their auth tokens are invisible to adminApp-bound Firestore)
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdminOrTeacher() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null;
    }

    // Departments — public read
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isSignedInAdmin();
    }

    // Config — admin only
    match /config/{configId} {
      allow read, write: if isSignedInAdmin();
    }

    // Exams — public read; teacher/admin write
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdminOrTeacher();
    }

    // Marks — public read; teacher/admin write
    match /marks/{markId} {
      allow read: if true;
      allow write: if isAdminOrTeacher();
    }

    // Attendance — public read; teacher/admin write
    match /attendance/{attId} {
      allow read: if true;
      allow write: if isAdminOrTeacher();
    }
  }
}
