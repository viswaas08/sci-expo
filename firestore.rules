rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin()   { return isSignedIn() && getRole() == 'admin'; }
    function isTeacher() { return isSignedIn() && getRole() == 'teacher'; }

    // Users — any signed-in user can read; admin/teacher write
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
      allow create: if isSignedIn();
    }

    // Departments
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Config
    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // Exams — any signed-in user can read (student/parent/teacher/admin)
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isTeacher() || isAdmin();
    }

    // Marks — any signed-in user can read; teacher/admin write
    match /marks/{markId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }

    // Attendance — any signed-in user can read; teacher/admin write
    match /attendance/{attId} {
      allow read: if isSignedIn();
      allow write: if isTeacher() || isAdmin();
    }
  }
}
